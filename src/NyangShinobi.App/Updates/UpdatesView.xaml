<UserControl x:Class="NyangShinobi.App.Updates.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:updates="clr-namespace:NyangShinobi.App.Updates">
  <UserControl.Resources>
    <updates:UpdateChannelLabelConverter x:Key="ChannelLabel" />
  </UserControl.Resources>
  <StackPanel Margin="24">
    <TextBlock Text="프로그램 업데이트" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Margin="0,12,0,4" Text="현재 버전" />
    <TextBlock Text="{Binding Updates.CurrentVersion}" AutomationProperties.AutomationId="UpdateCurrentVersion" />
    <TextBlock Margin="0,12,0,4" Text="채널 (Pre-release (테스트): RC·정식 / Stable: 정식만)" />
    <ComboBox ItemsSource="{Binding Updates.Channels}" SelectedItem="{Binding Updates.Channel}" IsEnabled="{Binding Updates.CanEdit}"
              AutomationProperties.AutomationId="UpdateChannel">
      <ComboBox.ItemTemplate>
        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ChannelLabel}, Mode=OneWay}" /></DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Button Content="업데이트 확인" Command="{Binding Updates.CheckCommand}" Margin="0,12,0,8" Padding="12,5"
            HorizontalAlignment="Left" AutomationProperties.AutomationId="CheckUpdate" />
    <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Updates.InstallationResult}" TextWrapping="Wrap" Margin="0,6,0,0" />
    <TextBlock Margin="0,12,0,4" Text="최신 버전" />
    <TextBlock Text="{Binding Updates.LatestVersion}" />
    <TextBox Text="{Binding Updates.Notes, Mode=OneWay}" IsReadOnly="True" Height="200" Margin="0,8"
             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Updates.Progress, Mode=OneWay}" Height="16" />
    <WrapPanel Margin="0,12,0,0">
      <Button Content="업데이트" Click="Install" IsEnabled="{Binding CanInstallUpdate}" Padding="16,6"
              AutomationProperties.AutomationId="InstallUpdate" />
      <Button Content="나중에" Command="{Binding Updates.LaterCommand}" Padding="16,6" Margin="8,0" />
      <Button Content="다운로드 취소" Command="{Binding Updates.CancelCommand}" Padding="16,6" />
    </WrapPanel>
    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="매크로·진단을 중지한 뒤 설치하세요. 설치 확인 후 앱이 종료되고 재실행됩니다. 사용자 설정은 보존합니다." />
  </StackPanel>
</UserControl>
