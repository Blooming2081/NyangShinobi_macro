<Window x:Class="NyangShinobi.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diagnostics="clr-namespace:NyangShinobi.App.Diagnostics"
        Title="냥냥시노비 v0.1" Width="960" Height="800" MinWidth="780" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <TabControl>
    <TabItem Header="실행">
      <StackPanel Margin="28">
    <TextBlock Text="냥냥시노비 v0.1" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Margin="0,12,0,18" TextWrapping="Wrap"
               Text="Task 02 · 현재 시작/중지는 골격 세션만 제어합니다. 게임 진행과 자동 입력은 실행하지 않습니다." />
    <TextBlock Text="모드 (Mission: 임무 / Mirror: 거울 / NekoNinja: 네코 닌자)" />
    <ComboBox Margin="0,6,0,10" ItemsSource="{Binding AvailableModes}"
              SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanStart}"
              AutomationProperties.AutomationId="ModeSelector" />
    <TextBlock Text="네코 닌자는 향후 10회 뽑기로 게임 재화를 소비하는 별도 모드입니다."
               TextWrapping="Wrap" Foreground="#8A4B00" />
    <StackPanel Orientation="Horizontal" Margin="0,18,0,16">
      <Button Content="시작" Width="110" Height="34" Command="{Binding StartCommand}"
              AutomationProperties.AutomationId="StartButton" />
      <Button Content="중지" Width="110" Margin="10,0,0,0" Command="{Binding StopCommand}"
              AutomationProperties.AutomationId="StopButton" />
    </StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionStatus" />
    <TextBlock Margin="0,8,0,0" Text="{Binding SettingsSummary}" Foreground="#555555" />
      </StackPanel>
    </TabItem>
    <TabItem Header="개발자 진단" AutomationProperties.AutomationId="DiagnosticsTab">
      <diagnostics:DiagnosticsView DataContext="{Binding Diagnostics}" />
    </TabItem>
  </TabControl>
</Window>
