  "criticalRules": [
    {
      "id": "mission_result_success",
      "requiresSameFrame": [
        "assets/images_nav/mission_success_title.png",
        "assets/images_nav/mission_clear.png"
      ],
      "excludes": [
        "assets/images_nav/mission_failed.png"
      ],
      "effect": "confirmed_success"
    },
    {
      "id": "mission_result_failure",
      "requires": [
        "assets/images_nav/mission_failed.png"
      ],
      "confirmButton": "assets/images_nav/mission_clear.png",
      "effect": "confirmed_failure"
    },
    {
      "id": "mission_card",
      "anyOf": [
        "assets/images_nav/reroll.png",
        "mission_three_card_layout",
        "extreme_acquired_layout"
      ],
      "effect": "run_skill_priorities"
    },
    {
      "id": "mirror_card",
      "requires": [
        "assets/images/image5.PNG",
        "mirror_card_layout_4_3_2_1"
      ],
      "effect": "select_cards_then_confirm"
    },
    {
      "id": "mirror_failure",
      "requires": [
        "assets/images/image8.PNG"
      ],
      "confirmButton": "assets/images/image9.PNG",
      "effect": "retry_entry"
    },
    {
      "id": "mirror_success_candidate",
      "requires": [
        "assets/images/image6.PNG"
      ],
      "alsoRequires": "UNVERIFIED_ADD_SECONDARY_SCREEN_EVIDENCE",
      "effect": "do_not_click_until_verified"
    },
    {
      "id": "mission_double_reward_optional",
      "onlyAfter": "mission_result_success",
      "requiresSameFrame": [
        "assets/images_nav/mission_success_title.png",
        "assets/images_nav/mission_clear.png"
      ],
      "option": "mission.doubleReward.enabled",
      "optionalEvidence": "assets/images_nav/mission_double_reward.png",
      "action": "tap_double_button_center_once_then_wait_for_distinct_screen_transition_and_return_to_success",
      "forbidden": "tap_old_confirm_coordinates_during_ad_or_reward_screen",
      "effect": "return_to_success_then_locate_fresh_mission_clear"
    },
    {
      "id": "neko_summon_page",
      "mode": "neko_ninja",
      "requires": [
        "assets/images_nav/neko_ninja_summon.png"
      ],
      "roiCount": 3,
      "action": "tap_ten_draw_at_normalized_305_1164_once_then_verify_transition",
      "forbidden": "tap_on_unknown_screen_or_during_pending_verification",
      "effect": "neko_result_or_next_summon_page"
    },
    {
      "id": "neko_summon_result",
      "mode": "neko_ninja",
      "requires": [
        "assets/images_nav/neko_ninja_result.png"
      ],
      "roiCount": 2,
      "action": "tap_continue_at_normalized_305_1164_once_then_verify_transition",
      "forbidden": "assume_result_from_summon_page_alone",
      "effect": "neko_summon_page_or_wait"
    }
