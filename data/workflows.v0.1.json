      "steps": [
        {
          "id": "D01",
          "check": "date_changed modal in known region",
          "then": "reserve frame and suspend active mode"
        },
        {
          "id": "D02",
          "action": "tap date changed OK only once at normalized 240,769; verify closed"
        },
        {
          "id": "D03",
          "action": "recompute schedule at Windows local time minus 4 hours"
        },
        {
          "id": "D04",
          "action": "wait for home refresh; close known daily followup popup at normalized 440,49 if detected"
        },
        {
          "id": "D05",
          "action": "probe and handle enabled AfterDateChange events during home wait (overlay may obstruct home)"
        },
        {
          "id": "D06",
          "action": "require two consecutive home-ready frames or NeedsUserAction at timeout"
        },
        {
          "id": "D07",
          "action": "resume previous game mode from home using refreshed schedule"
        }
      ]
    },
