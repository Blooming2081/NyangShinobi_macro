root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,xml,xaml,csproj,props,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Windows PowerShell 5.1 must read the Korean filenames/text as UTF-8.
[tools/Publish-Portable.ps1]
charset = utf-8-bom

[tools/Test-PortableLayout.ps1]
charset = utf-8-bom
